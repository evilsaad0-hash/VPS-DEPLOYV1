# ================= ZylexNode V22 =================
DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE
BOT_NAME=ZylexNode
PREFIX=!
BOT_VERSION=22.0-ZylexNode-KVM-LXC-Rescue
BOT_DEVELOPER=rehan.404

# Main Discord admin
MAIN_ADMIN_ID=PUT_MAIN_ADMIN_DISCORD_ID
VPS_USER_ROLE_ID=0
DEPLOY_ROLE_ID=0

# Node / storage
YOUR_SERVER_IP=
DEFAULT_STORAGE_POOL=default
HOST_MOTD=
VPS_DB_PATH=/opt/zylexnode/vps_data.db

# Default deployment policy
DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=1
DEPLOY_RAM=16
DEPLOY_CPU=3
DEPLOY_DISK=80
VPS_DEPLOY_LIMIT=2
DEPLOY_SLOT=0
NODE_DEFAULT_SLOTS=100

# LXC security / Docker
VPS_PRIVILEGED=false
VPS_NESTING=true
VPS_HARDEN_SSH=true
VPS_DOCKER_READY=true
VPS_DOCKER_KERNEL_MODULES=overlay,br_netfilter

# KVM / libvirt
KVM_ENABLED=true
KVM_IMAGE_DIR=/var/lib/libvirt/images/voxelcloud
KVM_NETWORK=default
KVM_CPU_MODE=auto
KVM_CPU_AUTO_FALLBACK=true
KVM_AUTOSTART=true
KVM_NETWORK_REPAIR_ON_START=true
KVM_GUEST_NETWORK_TIMEOUT=120
KVM_QGA_WAIT_TIMEOUT=180

# SSH / public access
KVM_PINGGY_ENABLED=true

# Cloudflare (optional; never paste the token into Discord)
CLOUDFLARE_INSTALL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=

# Pterodactyl (optional)
PTERO_PANEL_URL=
PTERO_API_KEY=
PTERO_DEFAULT_NEST_ID=1
PTERO_DEFAULT_EGG_ID=1
PTERO_DEFAULT_ALLOCATION_ID=1

# Optional Proxmox web URL. This is informational only; the bot console never exposes the Proxmox host shell.
PROXMOX_WEB_URL=

# KVM reliability/capacity tuning
KVM_MIN_FREE_MEMORY_GB=1
KVM_MIN_FREE_DISK_GB=5
KVM_BOOT_TIMEOUT=90

# Reserved for a future native Proxmox API/console integration; not wired by this bot build.
# Do not treat PROXMOX_WEB_URL as authenticated console access. Never use a Proxmox root password.
PROXMOX_API_URL=
PROXMOX_API_TOKEN_ID=
PROXMOX_API_TOKEN_SECRET=
PROXMOX_NODE=
PROXMOX_VERIFY_SSL=true
